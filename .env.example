# Postgres connection string for production (Neon, Vercel Postgres, Supabase, etc).
# Leave unset for local dev — the app falls back to an embedded PGlite database
# stored at .pglite-data/, which speaks real Postgres SQL so the schema needs no changes
# when you switch to a hosted database.
DATABASE_URL=

# Password for the /admin area (interview log, kill-criteria dashboard, survey analytics,
# and the survey open/closed toggle). Pick a real value before deploying.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-too

# The unguessable path segment participants use to reach the survey, e.g.
# https://your-deployment.vercel.app/s/<this value>. Generate the same way as above.
# Keep this out of version control once set for real fielding.
SURVEY_LINK_TOKEN=dev-token-change-me
